/**
 * 蜗牛 I 4K (wn4k.com) 自动签到 — Loon 脚本
 *
 * 功能：
 *  1. 优先用已保存的 Cookie 直接签到
 *  2. Cookie 失效（过期/未登录）时，自动用账号密码重新登录并刷新 Cookie
 *  3. 结果通过 Loon 通知推送
 *
 * 账号信息可用三种方式配置（优先级从高到低）：
 *  A. Loon 持久化存储：键 wn4k_account，值格式  账号:密码
 *  B. 直接改下面的 ACCOUNT / PASSWORD 常量
 *  C. 手动写入 Cookie：持久化键 wn4k_cookie，值为完整 Cookie 字符串
 */

const SITE = "https://wn4k.com";
const UA =
  "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1";

// ==== 默认凭据（已内置，可留空改用持久化存储配置）====
let ACCOUNT = "321995875";
let PASSWORD = "yS1229..";
// ====================================================

const store = typeof $persistentStore !== "undefined" ? $persistentStore : null;

function read(key) {
  try { return store ? (store.read(key) || "") : ""; } catch (e) { return ""; }
}
function write(key, val) {
  try { if (store) store.write(val, key); } catch (e) {}
}

// 持久化配置覆盖内置凭据
(function loadCredentials() {
  const saved = read("wn4k_account");
  if (saved && saved.indexOf(":") > 0) {
    const i = saved.indexOf(":");
    ACCOUNT = saved.slice(0, i).trim();
    PASSWORD = saved.slice(i + 1);
  }
})();

function notify(title, subtitle, body) {
  try {
    if (typeof $notification !== "undefined") $notification.post(title, subtitle, body);
  } catch (e) {}
}

function buildHeaders(cookie, referer) {
  const h = {
    "User-Agent": UA,
    "X-Requested-With": "XMLHttpRequest",
    "Referer": referer || SITE + "/user/checkin.html",
    Origin: SITE,
    "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
  };
  if (cookie) h.Cookie = cookie;
  return h;
}

function form(obj) {
  return Object.keys(obj)
    .map((k) => encodeURIComponent(k) + "=" + encodeURIComponent(obj[k]))
    .join("&");
}

function parseJSON(str) {
  try { return JSON.parse(str); } catch (e) { return null; }
}

// 从响应头里提取 Set-Cookie，合并成一行
function extractCookie(headers, fallback) {
  const jar = {};
  if (fallback) {
    fallback.split(";").forEach((p) => {
      const i = p.indexOf("=");
      if (i > 0) jar[p.slice(0, i).trim()] = p.slice(i + 1).trim();
    });
  }
  const collect = (v) => {
    String(v).split(",").forEach((seg) => {
      const kv = seg.split(";")[0];
      const i = kv.indexOf("=");
      if (i > 0) {
        const k = kv.slice(0, i).trim();
        if (k && !/^Expires$/i.test(k)) jar[k] = kv.slice(i + 1).trim();
      }
    });
  };
  if (headers) {
    ["set-cookie", "Set-Cookie"].forEach((name) => {
      const v = headers[name];
      if (!v) return;
      if (Array.isArray(v)) v.forEach(collect);
      else collect(v);
    });
  }
  return Object.keys(jar)
    .map((k) => k + "=" + jar[k])
    .join("; ");
}

function login(cookie, cb) {
  if (!ACCOUNT || !PASSWORD) {
    return cb("未配置账号密码，且 Cookie 已失效", null);
  }
  $httpClient.post(
    {
      url: SITE + "/user/login.html",
      headers: buildHeaders(cookie, SITE + "/user/login.html"),
      body: form({ user_name: ACCOUNT, user_pwd: PASSWORD }),
    },
    function (err, resp, data) {
      if (err) return cb("登录请求失败：" + err, null);
      const r = parseJSON(data);
      const newCookie = extractCookie(resp && resp.headers, cookie);
      if (r && r.code === 1 && newCookie && /user_check=/.test(newCookie)) {
        write("wn4k_cookie", newCookie);
        return cb(null, newCookie);
      }
      return cb("登录失败：" + (r && r.msg ? r.msg : "响应异常"), null);
    }
  );
}

function checkin(cookie, cb) {
  $httpClient.post(
    { url: SITE + "/user/checkin.html", headers: buildHeaders(cookie), body: "" },
    function (err, resp, data) {
      if (err) return cb("签到请求失败：" + err, null);
      cb(null, parseJSON(data));
    }
  );
}

function describe(r) {
  if (!r) return "返回数据无法解析（可能被 Cloudflare 拦截）";
  if (r.code === 1) {
    const info = r.info || {};
    const pts = info.points || info.base_points || "?";
    const days = info.serial_days || info.continue_days || "?";
    return "签到成功，获得 " + pts + " 积分，已连续签到 " + days + " 天";
  }
  if (r.code === 1001) return "今日已签到，无需重复操作";
  return "签到未成功：" + (r.msg || "code=" + r.code);
}

function finish(title, sub, body) {
  notify(title, sub, body);
  console.log("[wn4k] " + title + " | " + sub + " | " + body);
  try { $done(); } catch (e) {}
}

function run(cookie, retried) {
  checkin(cookie, function (err, r) {
    if (!err && r && (r.code === 1 || r.code === 1001)) {
      return finish("蜗牛4K 签到", describe(r), "账号 " + ACCOUNT);
    }
    // Cookie 失效或异常 → 重新登录后再试一次
    if (!retried) {
      return login(cookie, function (lerr, newCookie) {
        if (lerr) return finish("蜗牛4K 签到失败", lerr, err || describe(r));
        run(newCookie, true);
      });
    }
    return finish("蜗牛4K 签到失败", err || describe(r), "可尝试手动更新 Cookie 或检查账号密码");
  });
}

(function main() {
  const cookie = read("wn4k_cookie");
  if (cookie && /user_check=/.test(cookie)) return run(cookie, false);
  login("", function (err, newCookie) {
    if (err) return finish("蜗牛4K 签到失败", err, "请检查账号密码是否正确");
    run(newCookie, true);
  });
})();
